    {
        "id": "b414f81721da3c9d",
        "type": "function",
        "z": "70b4eb047084ac75",
        "name": "function 2",
        "func": "// 1. Récupérer les états en mémoire\nlet bpm = flow.get('last_bpm') || 0;\nlet seuilBpm = flow.get('seuil_bpm') || 150;\nlet acquitte = flow.get('alarme_acquittee') || false;\n\nlet msgBpm = null;\n\n// 2. Identifier la source du message entrant\nif (msg.topic === \"esp32/button1\") {\n    let etatBtn = String(msg.payload).trim().toLowerCase();\n    // Si on appuie sur le bouton physique, on coupe l'alarme\n    if (etatBtn === \"1\" || etatBtn === \"on\" || etatBtn === \"true\") {\n        acquitte = true;\n        flow.set('alarme_acquittee', true);\n    }\n}\nelse if (msg.topic === \"esp32/slave/bpm\") {\n    let val = parseFloat(msg.payload);\n    if (!isNaN(val)) {\n        bpm = val;\n        flow.set('last_bpm', bpm);\n        msgBpm = { payload: bpm };\n\n        // Réarmement automatique dès que le BPM redescend sous le seuil\n        if (bpm <= seuilBpm) {\n            acquitte = false;\n            flow.set('alarme_acquittee', false);\n        }\n    }\n}\nelse {\n    // Mise à jour dynamique depuis ta box \"Seuil Alarme BPM\"\n    let val = parseFloat(msg.payload);\n    if (!isNaN(val) && val > 0) {\n        seuilBpm = val;\n        flow.set('seuil_bpm', seuilBpm);\n\n        if (bpm <= seuilBpm) {\n            acquitte = false;\n            flow.set('alarme_acquittee', false);\n        }\n    }\n}\n\n// 3. Allumer la LED (\"on\") si le seuil est dépassé et non acquitté, sinon l'éteindre (\"off\")\nlet alarme = (bpm > seuilBpm) && !acquitte;\nlet msgLed = { payload: alarme ? \"on\" : \"off\" };\n\n// Sortie 1 : Courbe + Jauge BPM | Sortie 2 : LED (esp32/output)\nreturn [msgBpm, msgLed];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 460,
        "wires": [
